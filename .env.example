# Copy to .env and adjust. Defaults work with `npm run db`.
PORT=3004
DATABASE_URL=postgres://postgres:postgres@localhost:5544/ticker
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Key for the short-code permutation. Changing it changes which codes NEW links get.
CODE_SECRET=change-me-too
# The address short links are shown with.
PUBLIC_BASE_URL=http://localhost:3004
# Set to 1 behind a proxy or load balancer so visitor IPs come from X-Forwarded-For.
TRUST_PROXY=0
# Link creation: a burst of N per account, refilled at N per minute.
LINK_RATE_BURST=30
# Redirect cache.
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=10000
# How often buffered clicks are written.
CLICK_FLUSH_MS=1000
